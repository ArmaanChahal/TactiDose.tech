# TactiDose configuration template. Copy to `.env` (never commit `.env`).
# Every cloud service is optional: with this file empty the full demo runs offline
# (SQLite + simulated carousel + offline voice + manual medication entry).

# ---------------------------------------------------------------- core
TACTIDOSE_DEMO_MODE=true             # enables /demo panel: clock travel, simulator faults, raw commands
# TACTIDOSE_CAREGIVER_PIN=4321        # require X-Caregiver-Pin for caregiver/demo changes
# TACTIDOSE_TIMEZONE=America/Vancouver   # IANA zone; default = this computer's zone
TACTIDOSE_NUM_SLOTS=6
TACTIDOSE_DEVICE_ID=tactidose-001
# TACTIDOSE_DATA_DIR=data             # SQLite DB, TTS cache, scanned label images (keep out of OneDrive/Dropbox)

# ---------------------------------------------------------------- hardware
# sim    = built-in virtual ESP32 (no hardware needed)
# serial = real ESP32 over USB serial
# none   = no hardware (every motor command fails closed)
TACTIDOSE_HARDWARE_MODE=sim
TACTIDOSE_SERIAL_PORT=auto            # auto | COM5 | /dev/ttyUSB0 | socket://127.0.0.1:7777
TACTIDOSE_SERIAL_BAUD=115200
TACTIDOSE_HW_AUTO_HOME=true
# TACTIDOSE_SIM_SPEED=1               # >1 makes the simulated carousel faster

# ---------------------------------------------------------------- dose policy (deterministic)
TACTIDOSE_DOSE_EARLY_MINUTES=30
TACTIDOSE_DOSE_LATE_MINUTES=120
TACTIDOSE_CONFIRM_WINDOW_MINUTES=180
TACTIDOSE_GATE_OPEN_TIMEOUT_S=60
TACTIDOSE_MIN_DOSE_INTERVAL_MINUTES=60
TACTIDOSE_MAX_DISPENSE_ATTEMPTS=3
# true = "What do I take now?" opens the compartment immediately (handoff §4.1)
# false (default) = it announces the dose and waits for "Dispense" / the big button
TACTIDOSE_CHECK_DUE_AUTO_DISPENSE=false

# ---------------------------------------------------------------- operational DB: TiDB (optional)
# Leave TIDB_HOST empty to use local SQLite. TiDB Cloud requires TLS (certifi CA used by default).
# TIDB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=xxxxxxxx.root
# TIDB_PASSWORD=
# TIDB_DATABASE=tactidose
# TIDB_SSL_CA=                        # optional CA bundle path
# TACTIDOSE_DATABASE_URL=             # or any SQLAlchemy URL (overrides TIDB_*)

# ---------------------------------------------------------------- offline voice input (Vosk)
TACTIDOSE_VOICE_ENABLED=true
TACTIDOSE_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15   # python -m tactidose download-voice-model
TACTIDOSE_VOICE_USE_GRAMMAR=true
TACTIDOSE_VOICE_MIN_CONFIDENCE=0.55
# TACTIDOSE_MIC_DEVICE=Microphone Array   # index or name substring

# ---------------------------------------------------------------- speech output (ElevenLabs, optional)
TACTIDOSE_TTS_PROVIDER=elevenlabs     # elevenlabs | offline | none  (falls back automatically)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TACTIDOSE_TTS_INCLUDE_MED_NAMES=true  # medication names are sent to ElevenLabs when online
# TACTIDOSE_AUDIO_OUTPUT_DEVICE=

# ---------------------------------------------------------------- label onboarding (Gemini, optional)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-flash-latest
TACTIDOSE_LABEL_EXTRACTOR=auto        # auto | gemini | fake (demo, no key) | disabled

# ---------------------------------------------------------------- analytics (Snowflake, optional)
# SNOWFLAKE_ACCOUNT=myorg-myaccount
# SNOWFLAKE_USER=
# SNOWFLAKE_TOKEN=                    # programmatic access token (recommended), or:
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_PRIVATE_KEY_FILE=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=TACTIDOSE
# SNOWFLAKE_SCHEMA=ANALYTICS
# SNOWFLAKE_ROLE=
TACTIDOSE_ANALYTICS_SALT=change-me-to-a-random-string
