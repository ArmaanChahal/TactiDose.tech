# TactiDose settings template.
#   1. Copy this file to `.env` in the project folder:  Copy-Item .env.example .env   (macOS/Linux: cp)
#   2. Paste the keys you have right after the "=" (no quotes, no spaces). Leave the others blank.
#   3. Test them:  python -m tactidose check-apis   ... then restart the app.
# `.env` is git-ignored: never commit keys, and never put real keys in this file.
# Every cloud service is optional: with every key blank the full demo runs offline
# (SQLite + simulated carousel + offline voice + rule-based assistant).
# Behind a TLS-inspecting proxy, set SSL_CERT_FILE and REQUESTS_CA_BUNDLE as real environment
# variables (not in this file) to a CA bundle that includes the proxy's root certificate.

# ================================================================ API KEYS (fill in what you use)

# ---- Gemini (recommended): AI assistant, AI report summaries, label scanning
# Free key: https://aistudio.google.com/apikey  (free-tier prompts may be reviewed by Google: demo data only)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash       # a Flash-Lite model (e.g. gemini-flash-lite-latest) usually has higher free limits
# TACTIDOSE_AGENT_THINKING_LEVEL=low  # Gemini thinking level: low | medium | high; low answers faster (empty = model default)

# ---- ElevenLabs (optional): natural voice for spoken replies and announcements
# https://elevenlabs.io -> Developers -> API Keys; give the key "Text to Speech" access (and Voices read)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=your-voice-id   # check-apis tells you one that works on your account (see the voice note below)

# ---- Gmail (optional): really email reports to the doctor (without it they are saved as .eml files)
# Needs 2-Step Verification and an app password: https://myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- TiDB Cloud (optional): the app's database in the cloud instead of local SQLite
# TiDB Cloud -> your cluster -> Connect. After filling these in, run once: python -m tactidose init-db
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=tactidose

# ---- Snowflake (optional): de-identified adherence and device events synced for analytics
# Trial: https://signup.snowflake.com ; then create a programmatic access token for SNOWFLAKE_TOKEN
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_TOKEN=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
TACTIDOSE_ANALYTICS_SALT=change-me-to-a-random-string   # set a long random string before the first sync

# ================================================================ app settings (the defaults are fine)

# ---------------------------------------------------------------- core
TACTIDOSE_DEMO_MODE=true             # enables /demo panel: clock travel, simulator faults, raw commands
# TACTIDOSE_CAREGIVER_PIN=4321        # require X-Caregiver-Pin for caregiver/demo changes
# TACTIDOSE_TIMEZONE=America/Vancouver   # IANA zone; default = this computer's zone
TACTIDOSE_NUM_SLOTS=3                 # pill containers on the device
TACTIDOSE_DEVICE_ID=tactidose-001
# TACTIDOSE_DATA_DIR=data             # SQLite DB, TTS cache, scanned label images (keep out of OneDrive/Dropbox)

# ---------------------------------------------------------------- drops (v2)
TACTIDOSE_MANUAL_COOLDOWN_MINUTES=60  # default global cooldown for new devices (doctor/family can change it)
TACTIDOSE_AUTO_DROP_ENABLED=true      # scheduled doses drop automatically even if the patient forgets
TACTIDOSE_AUTO_DROP_RETRY_MINUTES=5
TACTIDOSE_NOTIFY_CAREGIVERS_ON_DROP=true

# ---------------------------------------------------------------- accounts & portals (v2)
TACTIDOSE_ALLOW_REGISTRATION=true
TACTIDOSE_SEED_DEMO_ACCOUNTS=true     # demo mode: alex@demo.tactidose / sam@demo.tactidose / dr.lee@demo.tactidose
# TACTIDOSE_DEMO_PASSWORD=demo1234
# TACTIDOSE_COOKIE_SECURE=false       # set true when served over HTTPS

# ---------------------------------------------------------------- AI assistant (uses GEMINI_API_KEY above)
TACTIDOSE_AGENT_PROVIDER=auto         # auto = Gemini when GEMINI_API_KEY is set, else offline rule-based agent; rules = always offline
# TACTIDOSE_AGENT_MODEL=              # default: GEMINI_MODEL
TACTIDOSE_AGENT_RETRY_AFTER_S=60      # after a Gemini failure the offline assistant answers for this many seconds (0 = retry Gemini every message)
TACTIDOSE_REPORT_AI_SUMMARY=true      # Gemini summary of conversations (false = rule-based summary, also the fallback)
TACTIDOSE_LABEL_EXTRACTOR=auto        # auto | gemini | fake (demo, no key) | disabled
# GEMINI_FALLBACK_MODEL=gemini-flash-latest   # tried once if GEMINI_MODEL is not found

# ---------------------------------------------------------------- well-being check-in (optional; pip install -e ./tactidose-wellbeing)
TACTIDOSE_WELLBEING_ENABLED=true      # off automatically when the tactidose-wellbeing package is not installed
TACTIDOSE_WELLBEING_AFTER_DROP=true   # offer a check-in after every pill that drops (portal / kiosk / assistant)
TACTIDOSE_WELLBEING_AFTER_DROP_GAP_MINUTES=120  # at most one offer per patient in this many minutes (0 = every drop)
# TACTIDOSE_WELLBEING_CONFIG_FILE=    # urgent-support wording + VERIFIED crisis resources (see tactidose-wellbeing/config/)
# TACTIDOSE_WELLBEING_SESSION_TTL_S=1800
# TACTIDOSE_WELLBEING_SERVER_TTS=false  # true = check-in replies (which can read notes back) go through ElevenLabs too

# ---------------------------------------------------------------- guided judge demo (demo mode; /demo or /kiosk)
# TACTIDOSE_DEMO_PAUSE_SECONDS=7       # pause between the morning / noon / night slots (or: run --demo-pause-seconds)
# TACTIDOSE_DEMO_ANSWER_TIMEOUT_S=45   # no answer within this time counts as unclear
# TACTIDOSE_DEMO_BUZZER_SECONDS=5      # simulated buzzer after a pill drops
# TACTIDOSE_DEMO_CHECKIN_AI=true       # Gemini reads the free-text check-in when GEMINI_API_KEY is set (rules otherwise)

# ---------------------------------------------------------------- email (uses the SMTP_* lines above)
# SMTP_STARTTLS=true                  # port 587; or SMTP_PORT=465 with SMTP_SSL=true

# ---------------------------------------------------------------- hardware
# sim    = built-in virtual ESP32 (no hardware needed)
# serial = real ESP32 over USB serial
# none   = no hardware (every motor command fails closed)
TACTIDOSE_HARDWARE_MODE=sim
TACTIDOSE_SERIAL_PORT=auto            # auto | COM5 | /dev/ttyUSB0 | socket://127.0.0.1:7777
TACTIDOSE_SERIAL_BAUD=115200
TACTIDOSE_HW_AUTO_HOME=true
# TACTIDOSE_SIM_SPEED=1               # >1 makes the simulated carousel faster

# ---------------------------------------------------------------- dose policy (deterministic)
TACTIDOSE_DOSE_EARLY_MINUTES=30
TACTIDOSE_DOSE_LATE_MINUTES=120
TACTIDOSE_CONFIRM_WINDOW_MINUTES=180
TACTIDOSE_GATE_OPEN_TIMEOUT_S=60
TACTIDOSE_MIN_DOSE_INTERVAL_MINUTES=60
TACTIDOSE_MAX_DISPENSE_ATTEMPTS=3
# true = "What do I take now?" opens the compartment immediately (handoff §4.1)
# false (default) = it announces the dose and waits for "Dispense" / the big button
TACTIDOSE_CHECK_DUE_AUTO_DISPENSE=false

# ---------------------------------------------------------------- database (uses the TIDB_* lines above)
# Leave TIDB_HOST empty to use local SQLite. TiDB Cloud requires TLS. CA bundle: TIDB_SSL_CA, else the
# file named by the SSL_CERT_FILE / REQUESTS_CA_BUNDLE environment variables, else the certifi bundle.
# TIDB_SSL_CA=                        # optional CA bundle path
# TACTIDOSE_DATABASE_URL=             # or any SQLAlchemy URL (overrides TIDB_*)

# ---------------------------------------------------------------- offline voice input (Vosk)
TACTIDOSE_VOICE_ENABLED=true
TACTIDOSE_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15   # python -m tactidose download-voice-model
TACTIDOSE_VOICE_USE_GRAMMAR=true
TACTIDOSE_VOICE_MIN_CONFIDENCE=0.55
# TACTIDOSE_MIC_DEVICE=Microphone Array   # index or name substring

# ---------------------------------------------------------------- speech output (uses ELEVENLABS_API_KEY above)
TACTIDOSE_TTS_PROVIDER=elevenlabs     # elevenlabs | offline | none  (falls back automatically; offline = built-in voice even with a key)
# Voice note: the default voice JBFqnCBsd6RMkjVDRZzb ("George") is a legacy voice that accounts created
# after March 2026 cannot use. Set ELEVENLABS_VOICE_ID (ElevenLabs -> Voices) or keep the auto-pick below.
TACTIDOSE_ELEVENLABS_AUTO_VOICE=true  # if the voice is unavailable to the account, use its first premade voice
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
TACTIDOSE_TTS_INCLUDE_MED_NAMES=true  # medication names are sent to ElevenLabs when online
# TACTIDOSE_AUDIO_OUTPUT_DEVICE=

# ---------------------------------------------------------------- analytics (uses the SNOWFLAKE_* lines above)
# SNOWFLAKE_PASSWORD=                 # instead of SNOWFLAKE_TOKEN (password sign-in may require MFA)
# SNOWFLAKE_PRIVATE_KEY_FILE=         # or key-pair authentication
# SNOWFLAKE_DATABASE=TACTIDOSE
# SNOWFLAKE_SCHEMA=ANALYTICS
# SNOWFLAKE_ROLE=
