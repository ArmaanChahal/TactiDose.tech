        {"send": "CLOSE_GATE", "expect": ["OK GATE_CLOSED", "OK READY"]},
        {"send": "STATUS", "expect": ["status:state=READY,homed=1,slot=3,gate=CLOSED"]},
        {"send": "DISPENSE_SLOT 0", "within_ms": 25000, "expect": ["OK MOVING 0", "OK AT_SLOT 0", "OK GATE_OPEN"]},
        {"send": "CLOSE_GATE", "expect": ["OK GATE_CLOSED", "OK READY"]}
