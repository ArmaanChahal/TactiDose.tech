        {"send": "CLOSE_GATE", "expect": ["OK GATE_CLOSED"]},
        {"send": "HOME", "within_ms": 45000, "expect": ["OK HOMING", "OK HOMED", "OK READY"]},
        {"send": "STATUS", "expect": ["status:state=READY,homed=1,slot=0,gate=CLOSED"]}
      ]
    },
    {
      "name": "stop_during_dispense_never_opens_gate",
      "hardware_safe": true,
