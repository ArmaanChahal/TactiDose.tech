        {"send": "MOVE_SLOT", "expect": ["ERR INVALID_SLOT"]},
        {"send": "MOVE_SLOT 1 2", "expect": ["ERR INVALID_SLOT"]},
        {"send": "MOVE_SLOT 1000", "expect": ["ERR INVALID_SLOT"]},
        {"send": "DISPENSE_SLOT 6", "expect": ["ERR INVALID_SLOT"]},
        {"send": "DISPENSE_SLOT x", "expect": ["ERR INVALID_SLOT"]},
        {"send": "STATUS", "expect": ["status:state=READY,slot=0,gate=CLOSED"]},
        {"send": "MOVE_SLOT 002", "within_ms": 20000, "expect": ["OK MOVING 2", "OK AT_SLOT 2", "OK READY"]}
      ]
    },
    {
      "name": "dispense_happy_path",
      "hardware_safe": true,
      "steps": [
        {"boot": "ok", "expect": ["re:EVENT BOOT \\S+", "OK HOMING", "OK HOMED", "OK READY"]},
